{
  "controller_id": "{{ xinas_api_controller_id }}",
  "listen": {
    "kind": "unix",
    "socket": "{{ xinas_api_socket }}",
    "socketGroup": {{ _xinas_admin_gid }}
  },
  "tokens": {
    "{{ _xinas_api_admin_token }}": {
      "principal": "admin:bootstrap",
      "role": "admin"
    }
  },
  "agent": {
    "socket": "{{ xinas_api_agent_socket }}",
    "heartbeat_interval_ms": {{ xinas_api_agent_heartbeat_interval_ms }}
  },
  "internalTokensPath": "{{ xinas_api_config_dir }}/internal-tokens.json",
  "mcp": {{ (dict(http=(dict(host=xinas_api_mcp_http_host, port=xinas_api_mcp_http_port) | combine(dict(tls=dict(cert_file=xinas_api_mcp_http_tls_cert, key_file=xinas_api_mcp_http_tls_key)) if xinas_api_mcp_http_tls_cert | length > 0 else dict()))) if xinas_api_mcp_http_host | length > 0 else dict()) | to_json }},
  "tasks": {
    "max_inflight": {{ xinas_api_tasks_max_inflight }}
  },
  "seed": {
    "shares_manifest_path": "{{ xinas_api_seed_manifest_path }}"
  },
  "state": {
    "databasePath": "{{ xinas_api_state_dir }}/xinas.db",
    "auditJsonlPath": "{{ xinas_api_log_dir }}/audit.jsonl",
    "archiveDir": "{{ xinas_api_state_dir }}/archive"
  }
}
