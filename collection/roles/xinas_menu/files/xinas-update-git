#!/bin/bash
# /usr/local/sbin/xinas-update-git
#
# Privileged helper for xinas-menu's update flow. Runs as root via
# sudo (granted by /etc/sudoers.d/xinas-update) so that xinas-menu,
# running as the unprivileged xinnor user, can refresh tags and check
# out release tags in the root-owned /opt/xiNAS clone.
#
# xiNAS updates come from published GitHub Releases only (see
# docs/Installer/update-spec.md). This helper therefore fetches tags
# and checks out a release *tag* — it deliberately offers no way to
# pull or check out a branch (`main`/`master`).
#
# Whitelisted subcommands only — does not accept arbitrary arguments.
# Hard-coded REPO path — never trusts caller input for which repo to
# operate on.

set -euo pipefail

REPO=/opt/xiNAS
export GIT_TERMINAL_PROMPT=0
cd "$REPO"

case "${1:-}" in
    fetch)
        exec git fetch origin --tags --quiet
        ;;
    checkout)
        tag="${2:-}"
        # Accept only a semver release tag (optionally v-prefixed, optional
        # prerelease suffix). Reject branches, HEAD, refspecs, paths, etc.
        if [[ ! "$tag" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
            echo "refusing to check out non-release ref: '$tag'" >&2
            exit 2
        fi
        exec git checkout --quiet "$tag"
        ;;
    *)
        echo "Usage: $0 {fetch|checkout <vX.Y.Z>}" >&2
        exit 2
        ;;
esac
